# ---------------------------------------------------------------------------
# Sanjeev Power Controls — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Comma-separated host names. Add the real domain before deploying.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated origins for HTTPS form posts, e.g. https://www.example.in
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------------
# Preferred on hosting platforms (Vercel, Neon, Supabase). Takes priority over
# DB_ENGINE, e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# SQLite (default local setup). Leave DB_ENGINE and DATABASE_URL empty.
DB_ENGINE=
DB_NAME=db.sqlite3

# PostgreSQL example:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=spc
# DB_USER=spc_user
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- Dashboard backups -----------------------------------------------------
# Directory (relative to the project root) for database backups created in the
# dashboard. Keep it outside the web root and never commit it.
BACKUP_DIR=backups

# --- Sign-in protection ----------------------------------------------------
# Lock an account/IP after this many failures, for this many seconds.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Staff session lifetime in seconds (default 12 hours).
SESSION_COOKIE_AGE=43200

# --- Production security ---------------------------------------------------
# Only applied when DJANGO_DEBUG=False.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Set to True only when running behind a reverse proxy that terminates TLS.
USE_X_FORWARDED_PROTO=False

# --- Email delivery --------------------------------------------------------
# Outgoing email is managed from Admin panel > Email Manager. SMTP credentials
# saved there are encrypted and stored in the database, so the values below are
# only needed when EMAIL_MANAGER_TRANSPORT=django or for Django's own mail.
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
# Never commit a real password.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
ADMIN_NOTIFICATION_EMAIL=

# --- Email Manager ---------------------------------------------------------
# REQUIRED in production. Encrypts SMTP passwords stored in the database.
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it in the server environment only. Losing it makes saved passwords
# unreadable; changing it requires re-entering the SMTP password.
EMAIL_ENCRYPTION_KEY=

# database = use the SMTP settings saved in the dashboard (recommended).
# django   = use EMAIL_BACKEND above (tests, environment-only deployments).
EMAIL_MANAGER_TRANSPORT=database

# Attempts = 1 + EMAIL_MANAGER_AUTO_RETRIES. Only transient connection errors
# are retried automatically.
EMAIL_MANAGER_MAX_ATTEMPTS=3
EMAIL_MANAGER_AUTO_RETRIES=1
EMAIL_MANAGER_RETRY_DELAY=2

# Old email log records are pruned after this many days.
EMAIL_LOG_RETENTION_DAYS=180

# Public origin used for links in emails sent by management commands.
SITE_BASE_URL=https://www.sanjeevpowercontrols.in
